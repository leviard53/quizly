generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String?
  quizzes Quiz[]
}

model Quiz {
  id    String @id @default(cuid())
  title String
  data  String // JSON string of questions
  user  User @relation(fields: [userId], references: [id])
  userId String
  createdAt DateTime @default(now())
}
