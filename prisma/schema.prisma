generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String?
  quizzes Quiz[]
  jobs Job[]
}

model Quiz {
  id    String @id @default(cuid())
  title String
  data  String // JSON string of questions
  user  User @relation(fields: [userId], references: [id])
  userId String
  createdAt DateTime @default(now())
}

model Job {
  id     String   @id @default(cuid())
  fileName String
  status String  @default("queued")
  resultQuizId String?
  error  String?
  numberOfQuestions Int @default(10)
  user   User?   @relation(fields: [userId], references: [id])
  userId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
