# Environment variables used by Quizly (rename to .env and fill values)

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_this_to_a_random_value

# Google OAuth credentials (create these in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database (SQLite for dev)
DATABASE_URL="file:./dev.db"

# OpenAI (for quiz generation)
OPENAI_API_KEY=

# Optional Kahoot OAuth (if available)
KAHOOT_CLIENT_ID=
KAHOOT_CLIENT_SECRET=

# Optional S3 storage (production)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
